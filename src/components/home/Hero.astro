---
import { getWhatsAppUrl } from '../../config/site';

const whatsappUrl = getWhatsAppUrl();
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__wireframe" aria-hidden="true">
    <div class="hero__wf hero__wf--back" data-wf-layer data-wf-depth="9">
      <div class="hero__wf-frame">
        <div class="hero__wf-bar"></div>
        <div class="hero__wf-line hero__wf-line--full"></div>
        <div class="hero__wf-line hero__wf-line--two"></div>
        <div class="hero__wf-line hero__wf-line--half"></div>
        <div class="hero__wf-cta"></div>
        <div class="hero__wf-cols">
          <div class="hero__wf-col"></div>
          <div class="hero__wf-col"></div>
        </div>
      </div>
    </div>
    <div class="hero__wf hero__wf--mid" data-wf-layer data-wf-depth="20">
      <div class="hero__wf-frame">
        <div class="hero__wf-bar"></div>
        <div class="hero__wf-line hero__wf-line--full"></div>
        <div class="hero__wf-line hero__wf-line--two"></div>
        <div class="hero__wf-line hero__wf-line--half"></div>
        <div class="hero__wf-cta"></div>
        <div class="hero__wf-cols">
          <div class="hero__wf-col"></div>
          <div class="hero__wf-col"></div>
        </div>
      </div>
    </div>
    <div class="hero__wf hero__wf--front" data-wf-layer data-wf-depth="31" data-wf-rotate="0.7">
      <div class="hero__wf-frame">
        <div class="hero__wf-bar"></div>
        <div class="hero__wf-line hero__wf-line--full"></div>
        <div class="hero__wf-line hero__wf-line--two"></div>
        <div class="hero__wf-line hero__wf-line--half"></div>
        <div class="hero__wf-cta"></div>
        <div class="hero__wf-cols">
          <div class="hero__wf-col"></div>
          <div class="hero__wf-col"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="container hero__inner">
    <div>
      <p class="hero__kicker">Landing pages + Google e Meta</p>
      <h1 id="hero-title">Seu cliente já está procurando. Seu site precisa convencer.</h1>
      <p class="hero__lead">
        Crio landing pages rápidas e campanhas no Google e Meta para prestadores de serviços e
        pequenos negócios. Você fala diretamente comigo em todas as etapas.
      </p>
      <div class="hero__actions">
        <a
          class="btn btn--primary"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Falar com Willian no WhatsApp"
        >
          Falar com Willian
        </a>
        <a class="btn btn--ghost" href="#trabalhos">
          {' '}
          Ver trabalhos{' '}
        </a>
      </div>
    </div>
    <aside class="hero__meta" aria-label="Área de atendimento">
      <strong>Atendimento direto</strong>
      <span>Novo Hamburgo · Vale dos Sinos · atendimento em todo o Brasil</span>
    </aside>
  </div>
</section>

<script>
  import '../../scripts/hero-motion.ts';
</script>
