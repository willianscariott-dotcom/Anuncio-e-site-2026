---
import { getWhatsAppUrl } from '../../config/site';

const whatsappUrl = getWhatsAppUrl();
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__pixels" aria-hidden="true">
    <div class="hero__pixels-layer hero__pixels-layer--back" data-px-layer data-px-depth="9">
      <div class="px-cell px-cell--1616" style="--x: 4; --y: 6"></div>
      <div class="px-cell px-cell--88" style="--x: 10; --y: 18"></div>
      <div class="px-cell px-cell--248" style="--x: 13; --y: 8"></div>
      <div class="px-cell px-cell--168" style="--x: 19; --y: 14"></div>
      <div class="px-cell px-cell--1616" style="--x: 24; --y: 22"></div>
      <div class="px-cell px-cell--2416" style="--x: 31; --y: 16"></div>
      <div class="px-cell px-cell--3216" style="--x: 36; --y: 28"></div>
      <div class="px-cell px-cell--168" style="--x: 43; --y: 10"></div>
      <div class="px-cell px-cell--88" style="--x: 47; --y: 4"></div>
      <div class="px-cell px-cell--248" style="--x: 51; --y: 20"></div>
      <div class="px-cell px-cell--1616" style="--x: 27; --y: 32"></div>
      <div class="px-cell px-cell--168" style="--x: 57; --y: 30"></div>
      <div class="px-cell px-cell--2416" style="--x: 63; --y: 14"></div>
      <div class="px-cell px-cell--248" style="--x: 14; --y: 38"></div>
      <div class="px-cell px-cell--3216" style="--x: 34; --y: 42"></div>
      <div class="px-cell px-cell--168" style="--x: 52; --y: 42"></div>
    </div>
    <div class="hero__pixels-layer hero__pixels-layer--mid" data-px-layer data-px-depth="20">
      <div class="px-cell px-cell--168" style="--x: 6; --y: 10"></div>
      <div class="px-cell px-cell--248" style="--x: 12; --y: 22"></div>
      <div class="px-cell px-cell--1616" style="--x: 18; --y: 4"></div>
      <div class="px-cell px-cell--88" style="--x: 23; --y: 16"></div>
      <div class="px-cell px-cell--2416" style="--x: 29; --y: 26"></div>
      <div class="px-cell px-cell--3216" style="--x: 35; --y: 8"></div>
      <div class="px-cell px-cell--168" style="--x: 41; --y: 18"></div>
      <div class="px-cell px-cell--1616" style="--x: 45; --y: 32"></div>
      <div class="px-cell px-cell--248" style="--x: 50; --y: 10"></div>
      <div class="px-cell px-cell--3216" style="--x: 55; --y: 40"></div>
      <div class="px-cell px-cell--168" style="--x: 60; --y: 24"></div>
    </div>
    <div class="hero__pixels-layer hero__pixels-layer--front" data-px-layer data-px-depth="31">
      <div class="px-cell px-cell--2416" style="--x: 8; --y: 14"></div>
      <div class="px-cell px-cell--168" style="--x: 15; --y: 6"></div>
      <div class="px-cell px-cell--3216 px-cell--accent" style="--x: 21; --y: 20"></div>
      <div class="px-cell px-cell--1616" style="--x: 28; --y: 10"></div>
      <div class="px-cell px-cell--4024" style="--x: 34; --y: 24"></div>
      <div class="px-cell px-cell--248" style="--x: 40; --y: 14"></div>
      <div class="px-cell px-cell--3216 px-cell--accent" style="--x: 46; --y: 34"></div>
      <div class="px-cell px-cell--2416" style="--x: 52; --y: 28"></div>
    </div>
  </div>
  <div class="container hero__inner">
    <div>
      <p class="hero__kicker">Landing pages + Google e Meta</p>
      <h1 id="hero-title">Seu cliente já está procurando. Seu site precisa convencer.</h1>
      <p class="hero__lead">
        Crio landing pages rápidas e campanhas no Google e Meta para prestadores de serviços e
        pequenos negócios. Você fala diretamente comigo em todas as etapas.
      </p>
      <div class="hero__actions">
        <a
          class="btn btn--primary"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Falar com Willian no WhatsApp"
        >
          Falar com Willian
        </a>
        <a class="btn btn--ghost" href="#trabalhos">
          {' '}
          Ver trabalhos{' '}
        </a>
      </div>
    </div>
    <aside class="hero__meta" aria-label="Área de atendimento">
      <strong>Atendimento direto</strong>
      <span>Novo Hamburgo · Vale dos Sinos · atendimento em todo o Brasil</span>
    </aside>
  </div>
</section>

<script>
  import '../../scripts/hero-motion.ts';
</script>
