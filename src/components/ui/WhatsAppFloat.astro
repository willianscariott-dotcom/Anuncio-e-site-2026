---
import { SITE } from '../../config/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

const whatsappActive = SITE.whatsapp.length > 0;
---

{whatsappActive ? (
  <a
    class="whatsapp-float"
    href={`https://wa.me/${SITE.whatsapp}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Falar com Willian pelo WhatsApp"
  >
    <WhatsAppIcon />
  </a>
) : (
  <button
    type="button"
    class="whatsapp-float"
    data-whatsapp-demo=""
    aria-disabled="true"
    aria-label="Falar com Willian pelo WhatsApp — disponível em breve"
    title="O número de WhatsApp será ativado em breve."
  >
    <WhatsAppIcon />
  </button>
)}
