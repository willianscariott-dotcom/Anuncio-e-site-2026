---
import { SITE, getWhatsAppUrl } from '../../config/site';

const whatsappUrl = getWhatsAppUrl();
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href="/" aria-label={`${SITE.brand} — página inicial`}>
      <span class="brand__mark" aria-hidden="true"></span>
      {SITE.brand}
    </a>
    <nav class="header__nav" aria-label="Navegação principal">
      <a href="/#trabalhos">Portfólio</a>
      <a href="/#oferta">Oferta</a>
      <a href="/#atendimento">Atendimento</a>
    </nav>
    <a
      class="btn btn--primary btn--small"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Falar com Willian no WhatsApp"
    >
      Falar com Willian
    </a>
  </div>
</header>
